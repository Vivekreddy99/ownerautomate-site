  {
   "parameters": {
    "sendTo": "hello@ownerautomate.com",
    "subject": "=Table free: {{ $('Read the Reply').item.json.party }} at {{ $('Read the Reply').item.json.time }}, {{ $('Read the Reply').item.json.day }}",
    "emailType": "text",
    "message": "={{ $('Read the Reply').item.json.name }} just cancelled booking {{ $('Read the Reply').item.json.Booking }}: a table for {{ $('Read the Reply').item.json.party }} on {{ $('Read the Reply').item.json.day }} at {{ $('Read the Reply').item.json.time }}.\n\nThe table is free again. Offer it to the waitlist or open it online.",
    "options": {"appendAttribution": false, "senderName": "Rosa's Booking Bot"}
   },
